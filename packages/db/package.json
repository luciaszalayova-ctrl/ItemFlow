{
  "name": "@itemflow/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "test": "node -e \"console.log('No tests yet for @itemflow/db')\"",
    "migrate": "dotenv -e ../../.env prisma migrate dev --name init",
    "migrate:deploy": "dotenv -e ../../.env prisma migrate deploy",
    "seed": "dotenv -e ../../.env tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env prisma studio",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.0.0"
  }
}
