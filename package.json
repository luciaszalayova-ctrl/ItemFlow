{
  "name": "itemflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "concurrently \"corepack pnpm --filter @itemflow/web dev\" \"corepack pnpm --filter @itemflow/api dev\"",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "db:migrate": "corepack pnpm --filter @itemflow/db migrate",
    "db:seed": "corepack pnpm --filter @itemflow/db seed",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma"]
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.2.33",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "next": "^14.2.33",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
