# Lokal: direkter Postgres-String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itemflow_dev

# Neon (Produktion/Vercel): gepoolte URL — wird von der Vercel-Neon-Integration gesetzt
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon: direkte URL für Prisma-Migrationen (prisma migrate deploy)
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3001

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

OPENAI_API_KEY=

